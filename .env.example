# Copy this file to backend/.env (same level as requirements.txt) and fill in
# real local values.
# Names only here per MONSOONCOVER_SPEC.md §15.1 — never commit actual secrets.

ENVIRONMENT=development

# PostgreSQL is the frozen database choice (spec §11.2).
DATABASE_URL=postgresql+psycopg://monsooncover:monsooncover@localhost:5432/monsooncover

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:5173","http://localhost:5183"]
